<!DOCTYPE html>
<html>
  <head>
    <title>Along</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "layouts/main", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "https://www.youtube.com/iframe_api" %>

    <%= favicon_link_tag "/icon.svg", type: "image/svg+xml" %>
    <%= favicon_link_tag "/favicon.ico", sizes: "48x48" %>
    <%= favicon_link_tag "/apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png" %>
    <%= tag.meta property: "og:image", content: image_url("og.png") %>
    <%= tag.meta name: "twitter:card", content: "summary_large_image" %>

    <!-- Driver.js -->
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/driver.js@latest/dist/driver.js.iife.js" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/driver.js@latest/dist/driver.css" %>

    <%= render "layouts/honeybadger" if Rails.env.production? %>

    <%= javascript_importmap_tags %>
    <%= javascript_tag do %>
      window.rails_env = "<%= Rails.env %>"
      window.is_cypress = "<%= not ENV["CYPRESS"].nil? %>"
    <% end %>
  </head>
  <body>
    <div class="lheader"></div>
    <header>
      <nav>
        <h1 class="banner">Along</h1>
        <ul>
          <li>
            <% if user_signed_in? %>
              <%= button_to t(:logout),
                  destroy_user_session_path, method: :delete, class: "small link" %>
            <% else %>
              <%= link_to t(:sign_in), new_user_session_path %>
            <% end %>
          </li>
        </ul>
      </nav>
    </header>
    <div class="rheader"></div>
    <main>
      <div id="flash" class="flash">
        <%= render "layouts/flash" %>
      </div>
      <%= yield %>
    </main>
    <footer>
      Copyright &copy; Mauricio Fierro 2024
    </footer>
    <%= render "lessons/error" %>
  </body>
</html>

