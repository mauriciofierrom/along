<div id="<%= dom_id lesson %>" class="video-card">
  <%= image_tag(video_thumbnail_url(lesson), class: "thumbnail") %>
  <div class="title">
    <%= instrument_emoji(lesson) %>
    <%= link_to lesson.name, lesson, data: { turbo: false, testid: "lesson-link" } %>
  </div>

  <div class="action">
    <%= button_to (fa_icon "trash"),
      lesson,
      method: :delete,
      class: "link",
      data: { turbo_confirm: t("lessons.destroy.confirm") } %>
  </div>

  <% if Flipper.enabled?(:lesson_status) %>
    <% if (objective = lesson.current_objective) then %>
      <div class="subtitle">
        Now learning: <%= objective.name %>
      </div>
    <% end %>
  <% end %>
</div>
