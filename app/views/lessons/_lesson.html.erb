<%= tag.div id: dom_id(lesson), class: class_names("video-card", "fade-in": local_assigns[:new]), data: { tutorid: "lesson-item" } do %>
  <%= image_tag(video_thumbnail_url(lesson), class: "thumbnail") %>

  <%= tag.div class: "title", data: { tutorid: "lesson-item-title" } do %>
    <%= instrument_emoji(lesson) %>
    <%= link_to lesson.name, lesson, data: { turbo: false, testid: "lesson-link" } %>
  <% end %>

  <%= tag.div class: "action", data: { tutorid: "lesson-item-delete" } do %>
    <%= button_to (fa_icon "trash"),
      lesson,
      method: :delete,
      class: "link",
      data: { turbo_confirm: t("lessons.destroy.confirm") } %>
  <% end %>

  <% if Flipper.enabled?(:lesson_status) %>
    <% if (objective = lesson.current_section) then %>
      <div class="subtitle">
        Now learning: <%= objective.name %>
      </div>
    <% end %>
  <% end %>
<% end %>
