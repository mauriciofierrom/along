<%= tag.div class: "lessons", data: { controller: "lesson", lesson_tutorial_config_value: tutorial_config } do %>
  <div class="header">
    <div class="title">
      <h1><%= Lesson.model_name.human(count: 2) %></h1>
      <%=
        button_tag fa_icon("question-circle"),
          class: "link",
          type: :button,
          data: { action: "click->lesson#showTutorial", testid: "lesson-tutor" }
      %>
    </div>

    <div class="new">
      <%= link_to "#{t("actions.new")} #{Lesson.model_name.human}",
        new_lesson_path,
        data: { turbo_frame: dom_id(Lesson.new), tutorid: "new-lesson" }
      %>
    </div>
  </div>

  <%= turbo_frame_tag Lesson.new %>

  <%= turbo_frame_tag "lessons", class: "list", data: { tutorid: "lesson-list" } do %>
    <%= render partial: "lesson", collection: @lessons, cached: true %>
  <% end %>

  <%= paginate @lessons %>
<% end %>
